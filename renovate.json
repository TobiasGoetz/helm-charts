{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    ":semanticCommitTypeAll(deps)",
    ":semanticCommitScopeDisabled"
  ],
  "packageRules": [
    {
      "description": "Automerge non-major updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "GitHub Actions commits use ci prefix for release-please",
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "semanticCommitScope": null
    },
    {
      "description": "16.dev.<git sha> tags do not sort. Track the moving 16.dev tag by digest.",
      "matchPackageNames": ["dungfu/twitch-drops-miner"],
      "pinDigests": true,
      "ignoreUnstable": false,
      "allowedVersions": "/^16\\.dev$/"
    }
  ]
}
